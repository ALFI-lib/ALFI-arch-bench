diff --git a/benches/spline/bench_hermite.cpp b/benches/spline/bench_hermite.cpp
new file mode 100644
index 0000000..c52ca27
--- /dev/null
+++ b/benches/spline/bench_hermite.cpp
@@ -0,0 +1,69 @@
+#include <benchmark/benchmark.h>
+
+#include <ALFI/spline/hermite.h>
+
+#include "../bench_utils.h"
+#include "../bench_data.h"
+
+const std::vector<alfi::spline::HermiteSpline<>::Type> hermite_spline_types = {
+	alfi::spline::HermiteSpline<>::Types::Classic{},
+	alfi::spline::HermiteSpline<>::Types::Cardinal{0.1},
+	alfi::spline::HermiteSpline<>::Types::Akima{},
+	alfi::spline::HermiteSpline<>::Types::ModifiedAkima{},
+	alfi::spline::HermiteSpline<>::Types::Steffen{},
+};
+
+static void BM_hermite_spline(benchmark::State& state) {
+	const auto& [func_name, lambda] = funcs_and_ints[state.range(0)].first;
+	const auto& interval = funcs_and_ints[state.range(0)].second;
+	const auto& dist_type = dists[state.range(1)];
+	const auto& n = state.range(2);
+	const auto& type = hermite_spline_types[state.range(3)];
+	const std::vector<double> X = of_type<double>(dist_type, n, interval.first, interval.second);
+	const std::vector<double> Y = apply_func(X, lambda);
+	alfi::spline::HermiteSpline<> spline;
+	for (auto _ : state) {
+		spline = alfi::spline::HermiteSpline<>(X, Y, type);
+		benchmark::DoNotOptimize(spline);
+		benchmark::ClobberMemory();
+	}
+}
+BENCHMARK(BM_hermite_spline)
+	->ArgsProduct({
+		benchmark::CreateDenseRange(0, static_cast<int64_t>(funcs_and_ints.size()) - 1, 1),
+		benchmark::CreateDenseRange(0, static_cast<int64_t>(dists.size()) - 1, 1),
+		{32, 1024, 16384, 262144},
+		benchmark::CreateDenseRange(0, static_cast<int64_t>(hermite_spline_types.size()) - 1, 1),
+	})
+	->ArgNames({"func", "dist", "n", "type"});
+
+static void BM_hermite_spline_values(benchmark::State& state) {
+	const auto& [func_name, lambda] = funcs_and_ints[state.range(0)].first;
+	const auto& interval = funcs_and_ints[state.range(0)].second;
+	const auto& dist_type = dists[state.range(1)];
+	const auto& n = state.range(2);
+	const auto& nn = state.range(3);
+	const auto& type = hermite_spline_types[state.range(4)];
+	const std::vector<double> X = of_type<double>(dist_type, n, interval.first, interval.second);
+	const std::vector<double> Y = apply_func(X, lambda);
+	const std::vector<double> xx = of_type<double>(alfi::dist::Type::UNIFORM, nn, interval.first, interval.second);
+	const alfi::spline::HermiteSpline<> spline(X, Y, type);
+	std::vector<double> result;
+	for (auto _ : state) {
+		result = spline.eval(xx);
+		benchmark::DoNotOptimize(result);
+		benchmark::ClobberMemory();
+	}
+	const std::vector<double> expected = apply_func(xx, lambda);
+	add_error_metrics(state, result, expected);
+}
+BENCHMARK(BM_hermite_spline_values)
+	->ArgsProduct({
+		benchmark::CreateDenseRange(0, static_cast<int64_t>(funcs_and_ints.size()) - 1, 1),
+		benchmark::CreateDenseRange(0, static_cast<int64_t>(dists.size()) - 1, 1),
+		{32, 1024, 16384, 262144},
+		{nn},
+	})
+	->ArgNames({"func", "dist", "n", "nn"});
+
+BENCHMARK_MAIN();
\ No newline at end of file
